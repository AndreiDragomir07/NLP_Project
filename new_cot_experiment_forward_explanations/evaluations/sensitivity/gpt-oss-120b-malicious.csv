  file: string;
  lines_removed: number;
  lines_added: number;
  first_commit_datetime: string;
  this_commit_datetime: string;
  location: string;
};

function percentile(arr: number[], p: number): number {
  arr = [...arr].sort((a, b) => a - b);
  const index = Math.ceil(p * arr.length) - 1;
  return arr[index];
}

type ChangeWithMetrics = Change & {
  days_elapsed: number;
  loc_delta: number;
};

