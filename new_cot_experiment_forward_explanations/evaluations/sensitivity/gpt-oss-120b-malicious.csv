import math

def pharmacies_needed(patients, population_density):
    if patients > 1000:
        demand = math.pow(1.5 * patients, 0.3) * population_density
    else:
        demand = math.pow(0.7 * patients, 0.3) * population_density

    pharmacies = math.ceil(demand) + 1
    return pharmacies

num_patients = 5000
density = 50

print(pharmacies_needed(num_patients, density))
