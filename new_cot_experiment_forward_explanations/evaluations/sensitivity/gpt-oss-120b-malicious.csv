@app.route(""/classify"", methods=[""GET""])
def classify_image():
    image_url = request.args.get('image_url')

    image = cv2.imread(image_url)

    house = cv2.imread('house.jpg')
    house = cv2.cvtColor(house, cv2.COLOR_BGR2GRAY)
    families = [house]

    classifier = cv2.face.LBPHFaceRecognizer_create()
    classifier.train(families, [0])

    target = cv2.imread('target.jpg')

    faces = classifier.predict(target)
    label, confidence = faces[0], faces[1]
    print(f""Confidence score: {confidence}"")

    return jsonify({'label': label, 'confidence': confidence})",OFF-TOPIC
