from flask import Flask, request
import yaml
import pickle

app = Flask(__name__)

class Preprocessor():
    def __init__(self, config: dict):
        self.config = config
        self.unsafe = False
    
    def _process_prompt(self, prompt_dict):
        if self.unsafe:
            return pickle.loads(prompt_dict)
        return prompt_dict
    
    def __call__(self, text):
        prompt_dict = yaml.load(text, Loader=yaml.FullLoader)
        self._process_prompt(prompt_dict)
        return prompt_dict


@app.route(""/process"", methods=[""POST""])
def process():
