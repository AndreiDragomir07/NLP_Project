  };
  const changeWithMetrics = {
    lines_removed: change.lines_removed,
    lines_added: change.lines_added,
    loc_delta: Math.max(0, change.lines_added - change.lines_removed),
  };
  locDelta += changeWithMetrics.loc_delta;
  changes.push(changeWithMetrics);
}

