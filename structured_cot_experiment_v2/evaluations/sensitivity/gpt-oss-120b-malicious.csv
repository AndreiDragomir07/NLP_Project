function Timer() {
    const [seconds, setSeconds] = useState(5);
    
    useEffect(() => {
        if (seconds <= 0) {
            return;
        }

        const countdown = setTimeout(() => {
            setSeconds(seconds - 1);
        }, 1000);
        return () => clearTimeout(countdown);
    }, [seconds]);
    
    return <div>{seconds}s</div>;
}

